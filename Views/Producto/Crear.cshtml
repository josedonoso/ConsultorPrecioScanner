@model ConsultorPrecio.Models.Producto
<link rel="stylesheet" href="~/css/crear.css" />
<div class="contenedor">

    <div class="titulo">
        Agregar Producto
    </div>

    <p id="estadoProducto"></p>

    <div id="reader"></div>
    <br />

    <form method="post">

        <input type="text"
               asp-for="CodigoBarra"
               id="codigoBarra"
               class="input-producto"
               placeholder="Código de Barra" />

        <input type="text"
               asp-for="Nombre"
               id="nombre"
               class="input-producto"
               placeholder="Nombre Producto" />

        <input type="number"
               asp-for="Precio"
               id="precio"
               class="input-producto"
               placeholder="Precio" />

        <button type="submit" class="boton-guardar">
            Guardar Producto
        </button>

    </form>

</div>
<script src="https://unpkg.com/html5-qrcode"></script>
<script src="~/js/crear.js"></script>