@model ConsultorPrecio.Models.Producto

<link rel="stylesheet" href="~/css/consultor.css" />

<div class="contenedor">

    <div class="titulo">
        Consultor de Precios
    </div>

    <div id="reader"></div>

    <form id="formBuscar">
        <input type="text"
               id="codigoBarra"
               name="codigoBarra"
               placeholder="Escaneando..."
               readonly />

            <button type="button" class="boton-limpiar"
               onclick="limpiarBusqueda()">Limpiar  
           </button>
    </form>

    <div id="resultado"></div>

</div>

@if (Model != null){
    <hr />

    <h2>@Model.Nombre</h2>
    <h3>
        Precio:
        @Model.Precio.ToString("C0",
        new System.Globalization.CultureInfo("es-CL"))
    </h3>
}

<script src="https://unpkg.com/html5-qrcode"></script>
<script src="~/js/consultor.js"></script>